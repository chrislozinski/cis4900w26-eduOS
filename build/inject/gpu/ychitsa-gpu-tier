#!/usr/bin/env bash
set -euo pipefail

BASE="loglevel=3"
TIER=(
    ""
    "amdgpu.dc=0"
    "amdgpu.dc=0 iommu=soft"
    "nomodeset modprobe.blacklist=amdgpu"
)
LAST_TIER=$(( ${#TIER[@]} - 1 ))
LOG=/var/log/ychitsa-gpu-boot.log

trap 'echo "ychitsa-gpu-tier FAILED at line ${LINENO}: ${BASH_COMMAND}" | tee -a "${LOG}" > /dev/kmsg' ERR

cmdline_for() {
    echo "${BASE} ychitsa.gpu_tier=$1 ${TIER[$1]}"
}

current_tier() {
    grep -oP 'ychitsa.gpu_tier=\K[0-9]+' /proc/cmdline || echo 0
}

set_next_boot() {
    local line="GRUB_CMDLINE_LINUX_DEFAULT=\"$(cmdline_for "$1")\""
    if grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' /etc/default/grub; then
        sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|${line}|" /etc/default/grub
    else
        echo "${line}" >> /etc/default/grub
    fi

    # os-prober has documented multi-hour hangs scanning other block devices; this is a single-OS install, so skip it.
    if grep -q '^GRUB_DISABLE_OS_PROBER=' /etc/default/grub; then
        sed -i 's|^GRUB_DISABLE_OS_PROBER=.*|GRUB_DISABLE_OS_PROBER=true|' /etc/default/grub
    else
        echo 'GRUB_DISABLE_OS_PROBER=true' >> /etc/default/grub
    fi
    update-grub
}

stage() {
    t=$(current_tier)
    next=$(( t < LAST_TIER ? t + 1 : LAST_TIER ))
    set_next_boot "${next}"
}

confirm() {
    # Never confirm a tier whose desktop didn't actually come up.
    # (Replaces the old Requires=lightdm.service unit dependency, which made a
    # failed lightdm start knock this unit over instead of just skipping it.)
    systemctl is-active --quiet lightdm.service || exit 0

    t=$(current_tier)
    set_next_boot "${t}"
    echo "tier ${t} confirmed $(date -Is)" > "${LOG}"
    dmesg >> "${LOG}"
    if [ "${t}" -gt 0 ]; then
        mkdir -p /etc/ychitsa
        touch /etc/ychitsa/needs-gpu-recovery
    fi
}

retry_best() {
    set_next_boot 0
}

case "${1:-}" in
    stage) stage ;;
    confirm) confirm ;;
    retry-best) retry_best ;;
    *) exit 1 ;;
esac
