#!/usr/bin/env bash
set -euo pipefail

MNT=/mnt
TARGET_DISK=""
SQUASHFS_SRC=""
GRUB_CMDLINE="quiet loglevel=3 ychitsa.gpu_tier=0"
UPDATER_REPO_URL="https://github.com/chrislozinski/cis4900w26-eduOS.git"
LOG=/var/log/ychitsa-install.log

trap 'echo "ychitsa-install FAILED at line ${LINENO}: ${BASH_COMMAND}" | tee -a "${LOG}" > /dev/kmsg' ERR

log()  { echo "==> $*"; }
die()  { echo "FATAL: $*" >&2; exit 1; }

pick_disk() {
    local boot_dev
    boot_dev=$(findmnt -no SOURCE /run/live/medium | sed 's/[0-9]*$//')

    local menu_items=()
    while read -r name size; do
        [[ "/dev/${name}" == "${boot_dev}" ]] && continue
        menu_items+=("/dev/${name}" "${size}")
    done < <(lsblk -dpno NAME,SIZE | sed 's|/dev/||')

    TARGET_DISK=$(whiptail --menu "Select install target (ALL DATA WILL BE ERASED)" \
        20 70 8 "${menu_items[@]}" 3>&1 1>&2 2>&3) || exit 1
    whiptail --yesno "This will ERASE ALL DATA on ${TARGET_DISK}. Continue?" \
        10 60 --defaultno || exit 1
}

partition_disk() {
    log "Partitioning ${TARGET_DISK}"
    sgdisk --zap-all "${TARGET_DISK}"
    sgdisk -n1:0:+512M -t1:ef00 -c1:EFI  "${TARGET_DISK}"
    sgdisk -n2:0:0     -t2:8300 -c2:root "${TARGET_DISK}"
    partprobe "${TARGET_DISK}"
    mkfs.vfat -F32 "${TARGET_DISK}1"
    mkfs.ext4 -F   "${TARGET_DISK}2"
}

mount_target() {
    mount "${TARGET_DISK}2" "${MNT}"
    mkdir -p "${MNT}/boot/efi"
    mount "${TARGET_DISK}1" "${MNT}/boot/efi"
}

find_squashfs() {
    SQUASHFS_SRC=$(find /run/live/medium -maxdepth 2 -name '*.squashfs' | head -n1)
    [[ -n "${SQUASHFS_SRC}" ]] || die "Could not locate live squashfs under /run/live/medium"
}

clone_filesystem() {
    log "Cloning live filesystem to ${MNT}"
    unsquashfs -f -d "${MNT}" "${SQUASHFS_SRC}"
}

strip_live_packages() {
    chroot "${MNT}" apt-get purge -y \
        live-boot live-boot-initramfs-tools live-config live-config-systemd \
        || true
}

write_fstab() {
    local root_uuid efi_uuid
    root_uuid=$(blkid -s UUID -o value "${TARGET_DISK}2")
    efi_uuid=$(blkid -s UUID -o value "${TARGET_DISK}1")
    cat > "${MNT}/etc/fstab" <<EOF
UUID=${root_uuid}  /         ext4  errors=remount-ro  0 1
UUID=${efi_uuid}   /boot/efi vfat  umask=0077          0 2
EOF
}

ensure_grub_key() {
    local key="$1"
    local value="$2"
    if grep -q "^${key}=" "${MNT}/etc/default/grub"; then
        sed -i "s|^${key}=.*|${key}=${value}|" "${MNT}/etc/default/grub"
    else
        echo "${key}=${value}" >> "${MNT}/etc/default/grub"
    fi
}

write_grub_default() {
    ensure_grub_key GRUB_CMDLINE_LINUX_DEFAULT "\"${GRUB_CMDLINE}\""
    # os-prober has documented multi-hour hangs scanning other block devices;
    # this is a single-OS install, so skip it.
    ensure_grub_key GRUB_DISABLE_OS_PROBER true
    ensure_grub_key GRUB_TIMEOUT 0
    ensure_grub_key GRUB_TIMEOUT_STYLE hidden
}

install_bootloader() {
    for fs in dev proc sys; do mount --bind "/${fs}" "${MNT}/${fs}"; done
    # bind is non-recursive: bring efivarfs along so grub-install can write the
    # firmware boot entry (without it, it silently skips NVRAM and exits 0)
    if [ -d /sys/firmware/efi/efivars ]; then
        mount -t efivarfs efivarfs "${MNT}/sys/firmware/efi/efivars"
    fi
    # --uefi-secure-boot: install the shim-signed chain (works with SB on or off)
    # --force-extra-removable: also write EFI/BOOT/BOOTX64.EFI so the disk boots
    # even on firmware that ignores or loses NVRAM entries
    # Rebuild initramfs after stripping live packages (needs /dev and /proc).
    chroot "${MNT}" update-initramfs -u
    chroot "${MNT}" grub-install --target=x86_64-efi \
        --efi-directory=/boot/efi --bootloader-id=debian \
        --uefi-secure-boot --force-extra-removable --recheck
    chroot "${MNT}" grub-mkconfig -o /boot/grub/grub.cfg
    umount "${MNT}/sys/firmware/efi/efivars" 2>/dev/null || true
    for fs in dev proc sys; do umount "${MNT}/${fs}"; done
}

seed_updater_repo() {
    if [ -d "${MNT}/opt/cis4900-repo/.git" ]; then
        log "Updater repo already present at /opt/cis4900-repo"
        return 0
    fi
    if ! command -v git >/dev/null 2>&1; then
        log "git not available in live environment; skip updater seed"
        return 0
    fi
    # Best-effort: install may be offline. Do not fail the whole install.
    if ping -c1 -W3 github.com >/dev/null 2>&1 || \
       ping -c1 -W3 1.1.1.1 >/dev/null 2>&1; then
        log "Seeding /opt/cis4900-repo from ${UPDATER_REPO_URL}"
        mkdir -p "${MNT}/opt"
        if git clone --depth 1 "${UPDATER_REPO_URL}" "${MNT}/opt/cis4900-repo"; then
            log "Updater repo seeded"
        else
            log "Updater seed failed; clone later with: sudo git clone ${UPDATER_REPO_URL} /opt/cis4900-repo"
        fi
    else
        log "No network; skip updater seed"
    fi
}

finalize() {
    chroot "${MNT}" bash -c "echo ychitsa > /etc/hostname"
    if grep -qE '^127\.0\.1\.1[[:space:]]' "${MNT}/etc/hosts"; then
        sed -i 's/^127\.0\.1\.1.*/127.0.1.1 ychitsa/' "${MNT}/etc/hosts"
    else
        echo '127.0.1.1 ychitsa' >> "${MNT}/etc/hosts"
    fi
    rm -f "${MNT}/etc/machine-id"
    chroot "${MNT}" dbus-uuidgen --ensure=/etc/machine-id
    seed_updater_repo
    umount -R "${MNT}"
    whiptail --msgbox "Install complete. Remove the USB and reboot." 10 60
}

main() {
    pick_disk
    partition_disk
    mount_target
    find_squashfs
    clone_filesystem
    strip_live_packages
    write_fstab
    write_grub_default
    install_bootloader
    finalize
}

main "$@"
