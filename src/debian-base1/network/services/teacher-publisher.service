[Unit]
Description=CIS4900 Teacher State Publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=CIS4900_CLASSROOMS_FILE=/shared/classrooms.json
Environment=CIS4900_IFACE=
# Set CIS4900_DEV=1 only on lab images that intentionally use the default secret.
ExecStart=/usr/bin/python3 -m network.publisher
WorkingDirectory=/usr/local/share/cis4900-src/src/debian-base1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=teacher-publisher

[Install]
WantedBy=multi-user.target
