#!/bin/bash
# Usage: ychitsa-update [--force] [branch]   (default branch: main)
# --force: ignore recorded per-category state and treat everything as pending
# (recovery switch for when a prior run died partway or skipped a category).
#
# Pulls the requested branch into /opt/cis4900-repo and applies the parts that
# changed. Two code roots matter on an installed system:
#   systemd network code:  /usr/local/share/cis4900-src/src/debian-base1
#   user UI code:          /home/<user>/.config/launcher (and /etc/skel for new users)
# Both must be synced or restarts keep running stale code.
set -euo pipefail

FORCE=0
BRANCH="main"
for arg in "$@"; do
    case "$arg" in
        --force) FORCE=1 ;;
        *) BRANCH="$arg" ;;
    esac
done

REPO=/opt/cis4900-repo
REPO_URL=https://github.com/chrislozinski/cis4900w26-eduOS.git
SRC=$REPO/src/debian-base1
SYS_NET=/usr/local/share/cis4900-src/src/debian-base1/network
USERS=(testuser studentuser)

# Per-category "last commit actually applied". Kept separately from the repo's
# checked-out HEAD: HEAD gets fast-forwarded to origin unconditionally below
# regardless of what apply() finishes, so it can't be used to detect what's
# still pending (a category can be left unselected, or apply() can die
# partway through another category, without HEAD ever reflecting that).
STATE_FILE=/var/lib/ychitsa-update/applied.state

state_get() {
    [ -f "$STATE_FILE" ] || return 0
    awk -F= -v k="$1" '$1==k{print $2}' "$STATE_FILE"
}
state_set() {
    mkdir -p "$(dirname "$STATE_FILE")"; touch "$STATE_FILE"
    { grep -v "^$1=" "$STATE_FILE" || true; echo "$1=$2"; } > "$STATE_FILE.tmp"
    mv "$STATE_FILE.tmp" "$STATE_FILE"
}

# Users in the student role (any number of accounts, not just studentuser)
student_users() { getent group student | cut -d: -f4 | tr ',' ' '; }

restart_sync_services() {
    systemctl restart teacher-publisher.service 2>/dev/null || true
    for u in $(student_users); do
        [ -n "$u" ] && systemctl restart "student-agent@$u.service" 2>/dev/null || true
    done
}

if [ ! -d "$REPO/.git" ]; then
    echo "No repo at $REPO — cloning..."
    git clone --depth 1 --branch "$BRANCH" "$REPO_URL" "$REPO"
fi

OLD_HEAD=$(git -C "$REPO" rev-parse HEAD)

echo "Checking for updates on branch: $BRANCH"
git -C "$REPO" fetch --depth 1 origin "+refs/heads/$BRANCH:refs/remotes/origin/$BRANCH" --quiet

declare -A UPDATES
declare -A UPDATE_LABELS

check() {
    local key="$1"; local label="$2"; shift 2
    if [ "$FORCE" -eq 1 ]; then
        UPDATES[$key]=1
        UPDATE_LABELS[$key]="$label"
        return
    fi
    local base
    base="$(state_get "$key")"; base="${base:-$OLD_HEAD}"
    local pattern out
    for pattern in "$@"; do
        if ! out=$(git -C "$REPO" diff --name-only "$base..origin/$BRANCH" -- "$pattern" 2>/dev/null); then
            # base commit no longer resolvable (can happen with the --depth 1 shallow
            # clone once it ages out) - assume changed rather than silently skipping it
            out="unresolvable"
        fi
        if [ -n "$out" ]; then
            UPDATES[$key]=1
            UPDATE_LABELS[$key]="$label"
            return
        fi
    done
}

check "launcher"  "App code (launcher, Python widgets)"         \
    "src/debian-base1/config/launcher/" "src/debian-base1/widgets/"
check "i3"        "i3 and interface config"                     \
    "src/debian-base1/config/i3/" "src/debian-base1/config/interface/"
check "network"   "Network sync modules"                        \
    "src/debian-base1/network/"
check "makecode"  "MakeCode static build"                       \
    "src/debian-base1/widgets/makecode/"
check "services"  "Systemd service files"                       \
    "src/debian-base1/network/services/"
check "syscfg"    "System configs (Xorg, LightDM, NM, polkit)" \
    "build/inject/"
check "packages"  "New packages (apt)"                          \
    "build/packages/apps.list"
check "users"     "User and role setup scripts"                 \
    "src/debian-base1/config/users/"
check "waterfox"  "Waterfox browser"                            \
    "build/hooks/01-waterfox.sh"
check "updater"   "Updater (ychitsa-update itself)"             \
    "src/debian-base1/config/updateManager/"

UPDATE_KEYS=("${!UPDATES[@]}")
if [ ${#UPDATE_KEYS[@]} -eq 0 ]; then
    echo "Already up to date."
    exit 0
fi

echo ""
echo "Available updates:"
echo ""
i=1
declare -a ORDER
for key in launcher i3 network makecode services syscfg packages users waterfox updater; do
    [ "${UPDATES[$key]+_}" ] || continue
    echo "  [$i] ${UPDATE_LABELS[$key]}"
    ORDER[$i]=$key
    ((i++))
done
echo "  [a] Apply all updates"
echo ""
read -rp "Enter selection (comma-separated, e.g. 1,3): " CHOICE
echo ""

declare -A SELECTED
if [ "$CHOICE" = "a" ] || [ "$CHOICE" = "A" ]; then
    for key in "${!UPDATES[@]}"; do SELECTED[$key]=1; done
else
    IFS=',' read -ra NUMS <<< "$CHOICE"
    for n in "${NUMS[@]}"; do
        n="${n// /}"
        key="${ORDER[$n]:-}"
        [ -n "$key" ] && SELECTED[$key]=1
    done
fi

SELECTED_KEYS=("${!SELECTED[@]}")
if [ ${#SELECTED_KEYS[@]} -eq 0 ]; then
    echo "Nothing selected."
    exit 0
fi

echo "Pulling latest code (branch: $BRANCH)..."
git -C "$REPO" checkout -B "$BRANCH" "origin/$BRANCH" --quiet
echo ""

apply() {
    local key="$1"
    [ "${SELECTED[$key]+_}" ] || return 0
    echo "Applying: ${UPDATE_LABELS[$key]}"

    case "$key" in
    launcher)
        # launcher: UI code runs from each user's ~/.config/launcher
        for u in "${USERS[@]}"; do
            [ -d "/home/$u" ] || continue
            # Sync launcher configs/scripts 
            # we exclude icons/ and network/ because those come from different source dirs managed separately
            rsync -a --delete \
                --exclude='icons/' --exclude='network/' \
                "$SRC/config/launcher/" "/home/$u/.config/launcher/"
            # rsync -a mirrors git's tracked file mode, so a script committed without +x silently loses its executable bit on every deploy; force it back here instead of relying on git to have it right.
            chmod +x "/home/$u/.config/launcher/"*.sh
            # Widget files that the build hook places directly in the launcher dir
            rsync -a "$SRC/widgets/makecode/makecode-app.py"          "/home/$u/.config/launcher/"
            rsync -a "$SRC/widgets/fileNav/fileViewer.py"             "/home/$u/.config/launcher/"
            rsync -a "$SRC/widgets/library/library.py"                "/home/$u/.config/launcher/"
            rsync -a "$SRC/widgets/joinClassroom/join-classroom.py"   "/home/$u/.config/launcher/"
            rsync -a "$SRC/widgets/statusTray/tray_indicators.py"     "/home/$u/.config/launcher/"
            #  icons/ in the launcher dir
            rsync -a --delete "$SRC/icons/" "/home/$u/.config/launcher/icons/"
            chown -R "$u:$u" "/home/$u/.config/launcher/"
        done
        # Keep /etc/skel current so accounts created after this update are not stale
        rsync -a "$SRC/widgets/makecode/makecode-app.py"          /etc/skel/.config/launcher/
        rsync -a "$SRC/widgets/fileNav/fileViewer.py"             /etc/skel/.config/launcher/fileViewer.py
        rsync -a "$SRC/widgets/library/library.py"                /etc/skel/.config/launcher/
        rsync -a "$SRC/widgets/joinClassroom/join-classroom.py"   /etc/skel/.config/launcher/
        rsync -a "$SRC/widgets/statusTray/tray_indicators.py"     /etc/skel/.config/launcher/
        # lessonBuilder lives at /opt/cis4900/widgets/lessonBuilder per appbar-config-teacher.json
        mkdir -p /opt/cis4900/widgets/lessonBuilder
        rsync -a --delete "$SRC/widgets/lessonBuilder/" "/opt/cis4900/widgets/lessonBuilder/"
        chmod +x /opt/cis4900/widgets/lessonBuilder/*.py
        ;;
    i3)
        # i3: per-user window manager / interface configs
        for u in "${USERS[@]}"; do
            [ -d "/home/$u" ] || continue
            mkdir -p \
                "/home/$u/.config/i3" \
                "/home/$u/.config/vifm" \
                "/home/$u/.config/dunst" \
                "/home/$u/.config/rofi"
            # Files are renamed at destination, so match what 03-copy-assets.sh does
            cp "$SRC/config/i3/i3-config"       "/home/$u/.config/i3/config"
            cp "$SRC/config/i3/layout.json"     "/home/$u/.config/i3/layout.json"
            cp "$SRC/config/interface/picom.conf"          "/home/$u/.config/picom.conf"
            cp "$SRC/config/interface/vifmrc"              "/home/$u/.config/vifm/vifmrc"
            cp "$SRC/config/interface/notifications.conf"  "/home/$u/.config/dunst/dunstrc"
            cp "$SRC/config/interface/rofi-config.rasi"    "/home/$u/.config/rofi/config.rasi"
            cp "$SRC/config/interface/rofi-network.rasi"   "/home/$u/.config/rofi/rofi-network.rasi"
            # polybar/i3status are retired - remove leftovers from older installs
            rm -rf "/home/$u/.config/polybar" "/home/$u/.config/i3status"
            # Students get the sync agent autostart line (config-user-i3.sh adds
            # the same line; the raw i3-config copy above stripped it)
            if id -nG "$u" | grep -qw student; then
                printf '\nexec --no-startup-id /usr/local/bin/student-agent-session.sh\n' \
                    >> "/home/$u/.config/i3/config"
            fi
            chown -R "$u:$u" \
                "/home/$u/.config/i3/" \
                "/home/$u/.config/vifm/" \
                "/home/$u/.config/dunst/" \
                "/home/$u/.config/rofi/" \
                "/home/$u/.config/picom.conf" 2>/dev/null || true
        done
        rm -f /usr/local/bin/wifi-connect.sh   # relocated to ~/.config/launcher/
        ;;
    network)
        # network: systemd runs from cis4900-src; UIs import from ~/.config/launcher/network
        mkdir -p "$SYS_NET"
        rsync -a --delete --exclude='services/' "$SRC/network/" "$SYS_NET/"
        for u in "${USERS[@]}"; do
            [ -d "/home/$u" ] || continue
            rsync -a --exclude='services/' "$SRC/network/" "/home/$u/.config/launcher/network/"
            chown -R "$u:$u" "/home/$u/.config/launcher/network/"
        done
        rsync -a --exclude='services/' "$SRC/network/" /etc/skel/.config/launcher/network/
        if [ -f "$SRC/network/student-agent-session.sh" ]; then
            install -m 755 "$SRC/network/student-agent-session.sh" /usr/local/bin/student-agent-session.sh
        fi
        restart_sync_services
        ;;
    makecode)
        rsync -a --delete "$SRC/widgets/makecode/makecode-static/" "/opt/makecode/static/"
        for u in "${USERS[@]}"; do
            [ -d "/home/$u" ] || continue
            rsync -a "$SRC/widgets/makecode/makecode-app.py" "/home/$u/.config/launcher/"
            chown "$u:$u" "/home/$u/.config/launcher/makecode-app.py"
        done
        ;;
    services)
        # services: unit files + migration off the old non-templated student agent
        systemctl disable --now student-agent.service 2>/dev/null || true
        rm -f /etc/systemd/system/student-agent.service \
              /etc/systemd/system/multi-user.target.wants/student-agent.service
        rsync -a "$SRC/network/services/" /etc/systemd/system/
        systemctl daemon-reload
        for u in $(student_users); do
            [ -z "$u" ] && continue
            systemctl enable "student-agent@$u.service" 2>/dev/null || true
        done
        restart_sync_services
        ;;
    syscfg)
        # Do not ship always-on Xorg fbdev; remove leftover if present.
        rm -f /etc/X11/xorg.conf.d/20-fbdev.conf
        rsync -a "$REPO/build/inject/lightdm.conf" \
            "/etc/lightdm/lightdm.conf"
        rsync -a "$REPO/build/inject/nm-managed.conf" \
            "/etc/NetworkManager/conf.d/10-managed.conf"
        rsync -a "$REPO/build/inject/10-network-manager.rules" \
            "/etc/polkit-1/rules.d/10-network-manager.rules"
        systemctl restart NetworkManager 2>/dev/null || true
        ;;
    packages)
        apt-get update
        APT_LIST=$(grep -v '^#' "$REPO/build/packages/apps.list" | tr '\n' ' ')
        # shellcheck disable=SC2086
        apt-get install -y $APT_LIST
        ;;
    users)
        rsync -a "$SRC/config/users/create-users.sh"   /usr/local/bin/
        rsync -a "$SRC/config/users/user-roles.sh"     /usr/local/bin/
        rsync -a "$SRC/config/users/config-user-i3.sh" /usr/local/bin/
        chmod +x /usr/local/bin/create-users.sh /usr/local/bin/user-roles.sh \
                  /usr/local/bin/config-user-i3.sh
        bash /usr/local/bin/create-users.sh 2>/dev/null || true
        bash /usr/local/bin/user-roles.sh   2>/dev/null || true
        ;;
    waterfox)
        bash "$REPO/build/hooks/01-waterfox.sh"
        ;;
    updater)
        # Handled unconditionally after the apply loop (see self-update below)
        ;;
    esac

    state_set "$key" "$(git -C "$REPO" rev-parse origin/"$BRANCH")"
}

for key in launcher i3 network makecode services syscfg packages users waterfox updater; do
    apply "$key"
done

# Self-update: temp + mv so the running script's inode is never truncated
if ! cmp -s "$SRC/config/updateManager/ychitsa-update" /usr/local/bin/ychitsa-update; then
    cp "$SRC/config/updateManager/ychitsa-update" /usr/local/bin/.ychitsa-update.new
    chmod +x /usr/local/bin/.ychitsa-update.new
    mv -f /usr/local/bin/.ychitsa-update.new /usr/local/bin/ychitsa-update
    echo "Updater itself was updated."
fi

echo ""
echo "Done."
