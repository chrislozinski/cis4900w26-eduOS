* {
    font:               "Monospace 10";
    border-color:       #444444;
    text-color:         #ffffff;
    background-color:   #262626;
}

window {
    border:             1px solid;
    border-radius:      4px;
    width:              260px;
    padding:            0px;
}

mainbox {
    background-color:   #262626;
    padding:            0px;
    spacing:            0px;
}

inputbar {
    background-color:   #333333;
    padding:            6px 8px;
    border:             0px 0px 1px 0px solid;
    spacing:            6px;
}

prompt, entry {
    background-color:   transparent;
    text-color:         #ffffff;
}

listview {
    background-color:   #262626;
    padding:            4px 0px;
    spacing:            0px;
}

element {
    background-color:   #262626;
    text-color:         #ffffff;
    padding:            4px 8px;
}

element selected {
    background-color:   #3c3c3c;
    text-color:         #ffffff;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
}
