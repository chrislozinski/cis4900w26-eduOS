" Minimal vifm config 

only

cd ~

" settings
set vicmd=vim
set trash
set history=50
set sortnumbers
set wildmenu
set ignorecase
set smartcase

" interface
set number
set statusline="%t"
set dotfiles

" color
highlight clear
highlight Directory cterm=bold ctermfg=cyan
highlight Executable cterm=bold ctermfg=green  
highlight Selected cterm=bold ctermfg=magenta
highlight CurrLine cterm=reverse

" navigation
nnoremap gh :cd ~<cr>
nnoremap gw :cd ~/work<cr>
nnoremap gH :cd ~/homework<cr>
nnoremap gr :cd ~/resources<cr>
nnoremap gs :cd ~/submissions<cr>

"  mark specific locations
mark h ~/
mark w ~/work
mark H ~/homework
mark r ~/resources
mark s ~/submissions

