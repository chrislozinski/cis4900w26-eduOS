[bar/statusbar]
width = 21%
height = 25
offset-x = 79%
offset-y = 0
bottom = true
override-redirect = true
wm-name = polybar
cursor-click = pointer
cursor-scroll = ns-resize

radius = 4.0

background = #66000000
foreground = #ffffff

font-0 = JetBrains Mono Medium:size=9;2
font-1 = FontAwesome:size=10;3

padding-left = 8
padding-right = 5
module-margin = 4

modules-right = network volume battery datetime

[module/network]
type = custom/script
exec = ssid=$(nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | grep '^yes:' | cut -d: -f2); echo "%{T2}%{T-} ${ssid:---}"
interval = 10
click-left = wifi-connect.sh

[module/volume]
type = custom/script
exec = vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -oP '\d+(?=%)' | head -1); echo "%{T2}%{T-} ${vol:---}%"
interval = 5

[module/battery]
type = custom/script
exec = bat=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null); echo "%{T2}%{T-} ${bat:---}%"
interval = 30

[module/datetime]
type = internal/date
interval = 1
date = %Y-%m-%d
time = %H:%M:%S
label = %{T2}%{T-} %date%  %time%
