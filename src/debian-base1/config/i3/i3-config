# i3 config file - Clean desktop with sandboxed folders
set $mod Mod1
font pango:monospace 8

# === STARTUP ===
# Show desktop icons (pcmanfm in desktop mode)
exec --no-startup-id xterm -name vifm-sidebar -geometry 50x45+0+0 -e vifm

# Make vifm sidebar stick to the left
for_window [instance="vifm-sidebar"] floating enable
for_window [instance="vifm-sidebar"] sticky enable
for_window [instance="vifm-sidebar"] move position 0 px 0 px
for_window [instance="vifm-sidebar"] resize set 400 px 100 ppt
for_window [instance="vifm-sidebar"] border pixel 2

# === KEYBINDINGS ===
# Terminal
bindsym $mod+Return exec xterm

# Close window
bindsym $mod+Shift+q kill

# Program launcher
bindsym $mod+d exec dmenu_run

# Exit i3
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit?' -B 'Yes' 'i3-msg exit'"

# === STATUS BAR ===
bar {
    status_command i3status -c ~/.config/i3status/config
    position bottom
}
