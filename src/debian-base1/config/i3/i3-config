# i3 config file 
set $mod Mod1
font pango:monospace 8

# desktop background 
exec --no-startup-id xsetroot -solid "#292D3E"

# launch the workspace layout 
exec --no-startup-id "i3-msg 'workspace 1; append_layout ~/.config/i3/layout.json'"

# Launch sidebar and app window
exec --no-startup-id python3 ~/.config/launcher/launcher.py
exec --no-startup-id python3 ~/.config/launcher/app-window.py

# Sidebar layout; left side, no resize resized, killed or focused
for_window [title="Appbar"] border none
for_window [title="Appbar"] floating disable
no_focus [title="Appbar"]

# the app window layout 
for_window [title="AppWindow"] floating disable

#folder viewer
for_window [instance="folder_viewer"] floating disable

# keybinds
bindsym $mod+Return exec xterm
bindsym $mod+Shift+q kill
bindsym $mod+d exec dmenu_run
bindsym $mod+l exec python3 ~/.config/launcher/launcher.py
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit?' -B 'Yes' 'i3-msg exit'"

default_orientation horizontal
workspace_layout default

# i3 status bar 
bar {
    status_command i3status -c ~/.config/i3status/config
    position bottom
}




