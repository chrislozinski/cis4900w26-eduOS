# i3 config file
set $mod Mod1
font pango:monospace 8

# desktop background
exec --no-startup-id xsetroot -solid "#292D3E"
exec --no-startup-id picom --config ~/.config/picom.conf --backend xrender -b

# PipeWire audio stack, sets XDG_RUNTIME_DIR, starts pipewire/wireplumber, loads xrdp sink
exec --no-startup-id ~/.config/launcher/start-audio.sh
exec --no-startup-id dunst

# launch workspace layout 
exec --no-startup-id "i3-msg 'workspace 1; append_layout ~/.config/i3/layout.json'"

# launch sidebar and app window
exec --no-startup-id python3 ~/.config/launcher/launcher.py
exec --no-startup-id python3 ~/.config/launcher/app-window.py

# make sure that the sidebar that cant resize, focus, close
for_window [title="Appbar"] border none
for_window [title="Appbar"] floating disable
no_focus [title="Appbar"]

# place the app window home page, stays in layout slot
for_window [title="AppWindow"] floating disable

# folder viewer
for_window [instance="folder_viewer"] floating disable
for_window [instance="folder_viewer"] move container to mark viewer_tabs

# zathura PDF viewer, opened from folder view
for_window [class="Zathura"] floating disable
for_window [class="Zathura"] move container to mark viewer_tabs

# fileViewer.py image viewer, with nsxiv embedded inside GTK window
for_window [instance="file_viewer"] floating disable
for_window [instance="file_viewer"] move container to mark viewer_tabs

# classroom manager, teacher widget for enabling apps
for_window [title="Classroom Manager"] floating disable
for_window [title="Classroom Manager"] move container to mark viewer_tabs

# join classroom, student widget for entering the teacher's code
for_window [title="Join Classroom"] floating disable
for_window [title="Join Classroom"] move container to mark viewer_tabs

# lesson config, teacher widget for configuring lesson resources
for_window [title="Lesson Config"] floating disable
for_window [title="Lesson Config"] move container to mark viewer_tabs

# library, student-facing research site launcher
for_window [instance="library"] floating disable
for_window [instance="library"] move container to mark viewer_tabs

# makecode editor
for_window [title="MakeCode"] floating disable
for_window [title="MakeCode"] move container to mark viewer_tabs

# xterm
for_window [class="XTerm"] move container to mark viewer_tabs

for_window [instance="webapp_viewer"] floating disable
for_window [instance="webapp_viewer"] move container to mark viewer_tabs

for_window [class="Waterfox"] floating disable
for_window [class="Waterfox"] move container to mark viewer_tabs

# keybinds
bindsym $mod+Return exec xterm
bindsym $mod+Shift+q kill
bindsym $mod+d exec dmenu_run
bindsym $mod+l exec python3 ~/.config/launcher/launcher.py
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit?' -B 'Yes' 'i3-msg exit'"

default_orientation horizontal
workspace_layout default
tiling_drag off

# Disable mouse resizing by making border clicks do nothing
bindsym --border button1 nop
bindsym --border button3 nop

# Ensure borders are invisible to the mouse interaction model
default_border pixel 0
default_floating_border pixel 0

bindsym $mod+shift+n exec xterm -e nmtui

bindsym XF86AudioRaiseVolume exec --no-startup-id sh -c "pactl set-sink-volume @DEFAULT_SINK@ +5% && notify-send -r 91190 -t 800 -h int:value:\$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\\d+(?=%)' | head -1) 'Volume' ''"
bindsym XF86AudioLowerVolume exec --no-startup-id sh -c "pactl set-sink-volume @DEFAULT_SINK@ -5% && notify-send -r 91190 -t 800 -h int:value:\$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\\d+(?=%)' | head -1) 'Volume' ''"
bindsym XF86AudioMute        exec --no-startup-id sh -c "pactl set-sink-mute @DEFAULT_SINK@ toggle && notify-send -t 800 'Volume' 'Muted'"
