general {
    colors = true
    interval = 5
}

order += "wireless _first_"
order += "disk /"
order += "load"
order += "memory"
order += "tztime local"

disk "/" {
    format = "disk: %avail"
}

load {
    format = "cpu: %1min"
}

memory {
    format = "ram: %used"
    threshold_degraded = "10%"
    format_degraded = "mem low: %free"
}

tztime local {
    format = "%Y-%m-%d %H:%M:%S"
}

wireless _first_ {
    format_up   = "wifi: %essid"
    format_down = "wifi: down"
    on_click 1  = "exec wifi-connect.sh"
}