general {
    colors = true
    interval = 5
}

order += "wireless _first_"
order += "volume master"
order += "battery all"
order += "tztime local" 

wireless _first_ {
    format_up   = "wifi: %essid"
    format_down = "wifi: down"
    on_click 1  = "exec wifi-connect.sh"
    separator_block_width = 25
}

volume master {
    format = "vol: %volume"
    format_muted = "vol: muted"
    device = "default"
    separator_block_width = 25
}

battery all {
    format = "bat: %percentage"
    separator_block_width = 25
}

tztime local {
    format = "%Y-%m-%d   %H:%M:%S"
    separator_block_width = 25
}